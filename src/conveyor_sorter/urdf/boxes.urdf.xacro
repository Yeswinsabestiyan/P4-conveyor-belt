<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="boxes">

  <!-- Box Macro (for dynamic spawning via markers) -->
  <xacro:macro name="box" params="box_name box_color parent_link *origin">
    <link name="${box_name}">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.1 0.1"/>
        </geometry>
        <material name="${box_color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.1 0.1"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${box_name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${box_name}"/>
      <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>

  <!-- Predefined box types for reference -->
  <box box_name="red_box" box_color="box_red" parent_link="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </box>

  <box box_name="blue_box" box_color="box_blue" parent_link="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </box>

  <box box_name="black_box" box_color="box_black" parent_link="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </box>

</robot>